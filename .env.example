# Choose ONE database URL format:
# 1) PostgreSQL (Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# 2) MySQL (Hostinger shared-hosting recommended):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4
# If password has special chars like #, @, /, ?, %, encode them in URL form.
# Example: Fcw#1029 becomes Fcw%231029
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
